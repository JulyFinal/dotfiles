#!/bin/sh
#MISE description="Sync shared skills for Codex, Claude Code, and Pi"
set -eu

usage() {
	printf '%s\n' \
		'Usage: skills-sync [--dry-run]' \
		'' \
		'Downloads each configured skill once into ~/.agents/skills and lets' \
		'the skills CLI link it into each configured agent.'
}

dry_run=false
case "${1:-}" in
'') ;;
--dry-run) dry_run=true ;;
-h | --help)
	usage
	exit 0
	;;
*)
	usage >&2
	exit 2
	;;
esac

script_path=$0
while [ -L "$script_path" ]; do
	link_target=$(readlink "$script_path")
	case "$link_target" in
	/*) script_path=$link_target ;;
	*) script_path=$(dirname -- "$script_path")/$link_target ;;
	esac
done
task_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
repo_dir=$(CDPATH= cd -- "$task_dir/../../.." && pwd)
manifest=${AGENT_SKILLS_MANIFEST:-"$repo_dir/manifests/agent-skills.yaml"}

if ! command -v yq >/dev/null 2>&1; then
	printf '%s\n' 'skills-sync requires yq (provided by the core Mise config).' >&2
	exit 1
fi
if ! $dry_run && ! command -v npx >/dev/null 2>&1; then
	printf '%s\n' 'skills-sync requires npx (provided by Node in the core Mise config).' >&2
	exit 1
fi
if [ ! -f "$manifest" ]; then
	printf 'Skill manifest not found: %s\n' "$manifest" >&2
	exit 1
fi
if [ "$(yq -r '.version // ""' "$manifest")" != 1 ]; then
	printf 'Unsupported skill manifest version: %s\n' "$manifest" >&2
	exit 1
fi

agents=$(yq -r '.agents[]' "$manifest")
if [ -z "$agents" ]; then
	printf 'No agents configured in %s\n' "$manifest" >&2
	exit 1
fi
for agent in $agents; do
	case "$agent" in
	*[!a-z0-9-]*)
		printf 'Invalid agent name: %s\n' "$agent" >&2
		exit 1
		;;
	esac
done

sources=$(yq -r '.sources[] | [.name, .source] | @tsv' "$manifest")
if [ -z "$sources" ]; then
	printf 'No skill sources configured in %s\n' "$manifest" >&2
	exit 1
fi

tab=$(printf '\t')
while IFS="$tab" read -r name source; do
	if [ -z "$name" ] || [ -z "$source" ]; then
		printf 'Invalid skill source in %s\n' "$manifest" >&2
		exit 1
	fi

	printf 'SYNC     %s (%s)\n' "$name" "$source"
	if $dry_run; then
		printf '         npx --yes skills@latest add %s --global --agent' "$source"
		for agent in $agents; do
			printf ' %s' "$agent"
		done
		printf ' --skill '\''*'\'' --yes\n'
		continue
	fi

	set -- npx --yes skills@latest add "$source" --global --agent
	for agent in $agents; do
		set -- "$@" "$agent"
	done
	set -- "$@" --skill '*' --yes
	"$@" </dev/null
done <<EOF
$sources
EOF
