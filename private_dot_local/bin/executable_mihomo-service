#!/usr/bin/env bash
set -euo pipefail

config=${XDG_CONFIG_HOME:-$HOME/.config}/mihomo/config.yaml
data_dir=${XDG_DATA_HOME:-$HOME/.local/share}/mihomo

if [[ ! -s "$config" ]]; then
    printf 'Mihomo configuration is not present: %s\n' "$config" >&2
    exit 0
fi

"$HOME/.local/bin/mihomo-managed" -t -d "$data_dir" -f "$config"
exec "$HOME/.local/bin/mihomo-managed" -d "$data_dir" -f "$config"
