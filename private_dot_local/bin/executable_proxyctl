#!/usr/bin/env bash
set -euo pipefail

systemd_unit=mihomo.service
launchd_label=io.github.metacubex.mihomo
launchd_plist=$HOME/Library/LaunchAgents/$launchd_label.plist
action=${1:-status}

linux_action() {
    case "$action" in
        start|stop|restart)
            systemctl --user "$action" "$systemd_unit"
            ;;
        status)
            systemctl --user status "$systemd_unit" --no-pager
            ;;
        log|logs)
            journalctl --user -u "$systemd_unit" -n 100 --no-pager
            ;;
        test) ;;
        *)
            return 2
            ;;
    esac
}

macos_action() {
    local domain=gui/$UID
    case "$action" in
        start)
            if launchctl print "$domain/$launchd_label" >/dev/null 2>&1; then
                launchctl kickstart -k "$domain/$launchd_label"
            else
                launchctl bootstrap "$domain" "$launchd_plist"
            fi
            ;;
        stop)
            launchctl bootout "$domain/$launchd_label"
            ;;
        restart)
            launchctl bootout "$domain/$launchd_label" >/dev/null 2>&1 || true
            launchctl bootstrap "$domain" "$launchd_plist"
            ;;
        status)
            launchctl print "$domain/$launchd_label"
            ;;
        log|logs)
            log show --style compact --last 1h \
                --predicate 'process == "mihomo"' | tail -n 100
            ;;
        test) ;;
        *)
            return 2
            ;;
    esac
}

case "$(uname -s)" in
    Darwin) macos_action || usage_error=true ;;
    Linux) linux_action || usage_error=true ;;
    *) printf 'Unsupported operating system: %s\n' "$(uname -s)" >&2; exit 1 ;;
esac

if [[ ${usage_error:-false} == true ]]; then
    printf 'Usage: proxyctl {status|start|stop|restart|logs|test}\n' >&2
    exit 2
fi

if [[ "$action" == test ]]; then
    if ! (
        exec 3<>/dev/tcp/127.0.0.1/10808
        exec 3>&-
        exec 3<&-
    ) 2>/dev/null; then
        printf '%s\n' 'FAIL: 127.0.0.1:10808 is not listening' >&2
        exit 1
    fi
    curl --silent --show-error --fail --max-time 12 \
        --proxy socks5h://127.0.0.1:10808 \
        https://www.google.com/generate_204 --output /dev/null
    printf '%s\n' 'OK: local proxy and external HTTP check passed'
fi
