#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.nix-profile/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

mihomo_path=$(command -v mihomo || true)
if [[ -z "$mihomo_path" ]]; then
    printf '%s\n' 'mihomo is not installed through Pacman, Homebrew, or Nix.' >&2
    exit 127
fi

exec "$mihomo_path" "$@"
