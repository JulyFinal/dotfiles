# Shared environment and aliases (including eproxy): home/config/shell/
[ -f "$HOME/.config/shell/common.sh" ] && source "$HOME/.config/shell/common.sh"
if [ -x /opt/homebrew/bin/brew ]; then eval "$(/opt/homebrew/bin/brew shellenv)"; fi
if [ -f "$HOME/.cargo/env" ]; then source "$HOME/.cargo/env"; fi

# eval
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"
command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh)"
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# zsh plugins
if [ -d "$HOME/.zsh/zsh-autosuggestions" ]; then source ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh; fi

autoload -U compinit; compinit
if [[ -o interactive && -t 0 && -t 1 ]] && command -v fzf >/dev/null 2>&1; then
    source <(fzf --zsh)
fi

command -v navi >/dev/null 2>&1 && eval "$(navi widget zsh)"

