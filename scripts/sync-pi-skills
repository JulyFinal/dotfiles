#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
manifest=${PI_SKILLS_MANIFEST:-$repo_dir/packages/pi-skills.txt}
target_root=${PI_SKILLS_TARGET_ROOT:-$HOME/.pi/agent/skills}
codex_home=${CODEX_HOME:-$HOME/.codex}
replace=false

if [[ ${1:-} == --replace ]]; then
    replace=true
elif (($#)); then
    printf 'Usage: %s [--replace]\n' "${0##*/}" >&2
    exit 2
fi

resolve_source() {
    local kind=$1
    local source_name=$2
    local marketplace plugin version_root candidate sort_command
    case "$kind" in
        codex-system)
            printf '%s\n' "$codex_home/skills/.system/$source_name"
            ;;
        codex-user)
            printf '%s\n' "$codex_home/skills/$source_name"
            ;;
        codex-plugin)
            marketplace=${source_name%%@*}
            plugin=${source_name#*@}
            version_root=$codex_home/plugins/cache/$marketplace/$plugin
            if [[ ! -d "$version_root" ]]; then
                return 1
            fi
            if command -v gsort >/dev/null 2>&1; then
                sort_command=gsort
            else
                sort_command=sort
            fi
            for candidate in "$version_root"/*/skills/"$plugin"; do
                [[ -d "$candidate" ]] && printf '%s\n' "$candidate"
            done | "$sort_command" -V | tail -n 1
            ;;
        *)
            printf 'Unknown Pi skill source kind: %s\n' "$kind" >&2
            return 2
            ;;
    esac
}

mkdir -p "$target_root"
target_root=$(cd -- "$target_root" && pwd -P)
linked=0
missing=0
blocked=0

while read -r target_name source_kind source_name extra; do
    [[ -z ${target_name:-} || $target_name == \#* ]] && continue
    if [[ -n ${extra:-} ]]; then
        printf 'Invalid Pi skill manifest row for %s\n' "$target_name" >&2
        exit 2
    fi

    source_path=$(resolve_source "$source_kind" "$source_name" || true)
    if [[ -z "$source_path" || ! -f "$source_path/SKILL.md" ]]; then
        printf 'MISS  %-16s source unavailable: %s %s\n' \
            "$target_name" "$source_kind" "$source_name" >&2
        missing=$((missing + 1))
        continue
    fi

    target_path=$target_root/$target_name
    if [[ -L "$target_path" ]]; then
        ln -sfn "$source_path" "$target_path"
    elif [[ -e "$target_path" ]]; then
        if ! $replace; then
            printf 'SKIP  %-16s real path exists; use --replace to migrate it\n' \
                "$target_name" >&2
            blocked=$((blocked + 1))
            continue
        fi
        case "$target_path" in
            "$target_root"/*) ;;
            *) printf 'Refusing unsafe Pi skill target: %s\n' "$target_path" >&2; exit 1 ;;
        esac
        find "$target_path" -depth -delete
        ln -s "$source_path" "$target_path"
    else
        ln -s "$source_path" "$target_path"
    fi
    printf 'LINK  %-16s -> %s\n' "$target_name" "$source_path"
    linked=$((linked + 1))
done < "$manifest"

printf 'Pi skills: %d linked, %d missing, %d blocked\n' \
    "$linked" "$missing" "$blocked"
