#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
target_home=${DOTFILES_HOME:-$HOME}
rules_file=$repo_dir/deploy.conf
secrets_file=${DOTFILES_SECRETS_FILE:-"$repo_dir/private.local/secrets.toml"}
private_home=${DOTFILES_PRIVATE_HOME:-"$repo_dir/private.local/home"}
private_templates=${DOTFILES_PRIVATE_TEMPLATES:-"$repo_dir/private/templates/home"}
yes=false
workspace=
sources=
actions=
action_count=0

cleanup() {
    [ -z "$workspace" ] || rm -rf "$workspace"
}
trap cleanup EXIT HUP INT TERM

usage() {
    cat <<'EOF'
Usage:
  ./dotfiles plan [core] [personal] [private]
  ./dotfiles apply [core] [personal] [private] [--yes]
  ./dotfiles install [core] [personal]
  ./dotfiles doctor [core] [personal] [private]
  ./dotfiles explain PATH

`apply` never accesses the network. `install` is the explicit networked action.
EOF
}

detect_platform() {
    case "$(uname -s)" in
        Darwin) printf '%s\n' macos ;;
        Linux)
            if [ -e /etc/arch-release ]; then
                printf '%s\n' arch
            else
                printf '%s\n' linux
            fi
            ;;
        *) printf '%s\n' unsupported ;;
    esac
}

platform=${DOTFILES_PLATFORM:-$(detect_platform)}
case "$platform" in
    arch | linux | macos) ;;
    *)
        printf 'Unsupported platform: %s\n' "$platform" >&2
        exit 1
        ;;
esac

new_workspace() {
    workspace=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-plan.XXXXXX")
    sources=$workspace/sources
    actions=$workspace/actions
    : >"$sources"
    : >"$actions"
    mkdir -p "$workspace/rendered"
}

validate_relative_path() {
    case "$1" in
        '' | . | .. | /* | ../* | */../* | */..) return 1 ;;
        *) return 0 ;;
    esac
}

set_source() {
    source_root=$1
    forced_method=$2
    [ -d "$source_root" ] || return 0

    find "$source_root" \( -type f -o -type l \) -print \
        | LC_ALL=C sort \
        | while IFS= read -r source_path; do
            relative=${source_path#"$source_root"/}
            validate_relative_path "$relative" || {
                printf 'Unsafe source path: %s\n' "$relative" >&2
                exit 1
            }
            awk -F '	' -v wanted="$relative" '$1 != wanted' "$sources" \
                >"$sources.next"
            mv "$sources.next" "$sources"
            printf '%s\t%s\t%s\n' "$relative" "$source_path" "$forced_method" \
                >>"$sources"
        done
}

add_platform_layers() {
    section=$1
    if [ "$platform" = arch ] || [ "$platform" = linux ]; then
        set_source "$repo_dir/overlays/linux/${section}home" ""
    fi
    if [ "$platform" = arch ]; then
        set_source "$repo_dir/overlays/arch/${section}home" ""
    elif [ "$platform" = macos ]; then
        set_source "$repo_dir/overlays/macos/${section}home" ""
    fi
}

collect_sources() {
    [ "$#" -gt 0 ] || set -- core
    for scope in "$@"; do
        case "$scope" in
            core)
                set_source "$repo_dir/home" ""
                add_platform_layers ""
                ;;
            personal)
                set_source "$repo_dir/personal/home" ""
                add_platform_layers "personal/"
                ;;
            private)
                set_source "$private_templates" template
                add_platform_layers "private/"
                set_source "$private_home" copy
                ;;
            *)
                printf 'Unknown scope: %s\n' "$scope" >&2
                exit 2
                ;;
        esac
    done
}

method_for() {
    wanted=$1
    forced=$2
    if [ -n "$forced" ]; then
        printf '%s\n' "$forced"
        return
    fi
    awk -v wanted="$wanted" '
        $1 !~ /^#/ && NF >= 2 && $2 == wanted { result = $1 }
        END { print result == "" ? "link" : result }
    ' "$rules_file"
}

mode_for() {
    wanted=$1
    method=$2
    configured=$(awk -v wanted="$wanted" '
        $1 !~ /^#/ && NF >= 3 && $2 == wanted { result = $3 }
        END { print result }
    ' "$rules_file")
    if [ -n "$configured" ]; then
        printf '%s\n' "$configured"
    elif [ "$method" = template ]; then
        printf '%s\n' 0600
    else
        printf '%s\n' 0644
    fi
}

extract_secret_tokens() {
    awk '
        {
            rest = $0
            while (match(rest, /@SECRET:[A-Za-z0-9_.-]+@/)) {
                print substr(rest, RSTART, RLENGTH)
                rest = substr(rest, RSTART + RLENGTH)
            }
        }
    ' "$1" | LC_ALL=C sort -u
}

render_template() {
    template=$1
    output=$2
    token_map=$workspace/token-map
    prepared=$workspace/prepared-template
    printf '@HOME@\t%s\n' "$target_home" >"$token_map"
    : >"$prepared"

    include=true
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            '@IF_COMMAND '*)
                command_name=${line#@IF_COMMAND }
                command_name=${command_name%@}
                case "$command_name" in
                    '' | *[!A-Za-z0-9._+-]*)
                        printf 'Invalid template command condition: %s\n' \
                            "$command_name" >&2
                        exit 1
                        ;;
                esac
                if command -v "$command_name" >/dev/null 2>&1; then
                    include=true
                else
                    include=false
                fi
                ;;
            '@END@') include=true ;;
            *) $include && printf '%s\n' "$line" >>"$prepared" ;;
        esac
    done <"$template"

    extract_secret_tokens "$prepared" \
        | while IFS= read -r token; do
            [ -n "$token" ] || continue
            command -v taplo >/dev/null 2>&1 || {
                printf 'Template %s needs Taplo; run ./dotfiles install core.\n' \
                    "$template" >&2
                exit 1
            }
            [ -f "$secrets_file" ] || {
                printf 'Missing secrets file: %s\n' "$secrets_file" >&2
                exit 1
            }
            key=${token#@SECRET:}
            key=${key%@}
            value=$(taplo get -f "$secrets_file" -s "$key") || {
                printf 'Missing secret key: %s\n' "$key" >&2
                exit 1
            }
            case "$value" in
                *"	"* | *"
"*)
                    printf 'Secret %s contains an unsupported tab or newline.\n' "$key" >&2
                    exit 1
                    ;;
            esac
            printf '%s\t%s\n' "$token" "$value" >>"$token_map"
        done

    awk -F '	' '
        function literal_replace(text, needle, value, before) {
            while ((before = index(text, needle)) > 0) {
                text = substr(text, 1, before - 1) value \
                    substr(text, before + length(needle))
            }
            return text
        }
        NR == FNR {
            split_at = index($0, "\t")
            key = substr($0, 1, split_at - 1)
            values[key] = substr($0, split_at + 1)
            next
        }
        {
            line = $0
            for (key in values) line = literal_replace(line, key, values[key])
            print line
        }
    ' "$token_map" "$prepared" >"$output"
}

show_diff() {
    current=$1
    desired=$2
    if [ -f "$current" ] && [ ! -L "$current" ] && [ -f "$desired" ]; then
        diff -u "$current" "$desired" || true
    fi
}

build_plan() {
    index=0
    action_count=0
    printf 'Platform: %s\nTarget:   %s\n\n' "$platform" "$target_home"

    while IFS='	' read -r relative source_path forced_method; do
        [ -n "$relative" ] || continue
        method=$(method_for "$relative" "$forced_method")
        mode=$(mode_for "$relative" "$method")
        target=$target_home/$relative
        desired=$source_path

        if [ "$method" = template ]; then
            index=$((index + 1))
            desired=$workspace/rendered/$index
            render_template "$source_path" "$desired"
        fi

        unchanged=false
        if [ "$method" = link ]; then
            if [ -L "$target" ] && [ "$(readlink "$target")" = "$source_path" ]; then
                unchanged=true
            fi
        elif [ -f "$target" ] && [ ! -L "$target" ] && cmp -s "$target" "$desired"; then
            unchanged=true
        fi

        if $unchanged; then
            printf 'KEEP     %s\n' "$target"
            continue
        fi

        if [ -e "$target" ] || [ -L "$target" ]; then
            printf 'REPLACE  %s  (%s)\n' "$target" "$method"
            show_diff "$target" "$desired"
        else
            printf 'CREATE   %s  (%s)\n' "$target" "$method"
        fi
        printf '%s\t%s\t%s\t%s\t%s\n' \
            "$method" "$relative" "$desired" "$target" "$mode" >>"$actions"
        action_count=$((action_count + 1))
    done <"$sources"

    printf '\n%d change(s) planned.\n' "$action_count"
}

apply_actions() {
    while IFS='	' read -r method relative desired target mode; do
        [ -n "$target" ] || continue
        parent=${target%/*}
        mkdir -p "$parent"
        if [ -d "$target" ] && [ ! -L "$target" ]; then
            rm -rf "$target"
        else
            rm -f "$target"
        fi
        if [ "$method" = link ]; then
            ln -s "$desired" "$target"
        else
            cp "$desired" "$target"
            chmod "$mode" "$target"
        fi
        printf 'APPLIED  %s\n' "$target"
    done <"$actions"
}

configure_secret_hook() {
    if [ "$target_home" = "$HOME" ] && git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1; then
        git -C "$repo_dir" config core.hooksPath tests
        printf 'ENABLED  repository secret-scanning hook\n'
    fi
}

run_plan_or_apply() {
    operation=$1
    shift
    scopes=
    for argument in "$@"; do
        if [ "$argument" = --yes ]; then
            yes=true
        else
            scopes="$scopes $argument"
        fi
    done
    # Scope names are fixed words, so intentional field splitting is safe here.
    # shellcheck disable=SC2086
    set -- $scopes
    [ "$#" -gt 0 ] || set -- core

    new_workspace
    collect_sources "$@"
    build_plan
    [ "$operation" = apply ] || return 0
    if [ "$action_count" -eq 0 ]; then
        configure_secret_hook
        return 0
    fi

    if ! $yes; then
        printf '\nApply these changes? [y/N] '
        IFS= read -r answer
        case "$answer" in
            y | Y | yes | YES) ;;
            *)
                printf '%s\n' 'Cancelled.'
                return 1
                ;;
        esac
    fi
    apply_actions
    configure_secret_hook
}

run_install() {
    [ "$#" -gt 0 ] || set -- core
    install_core=false
    install_personal=false
    for scope in "$@"; do
        case "$scope" in
            core) install_core=true ;;
            personal) install_personal=true ;;
            private) ;;
            *)
                printf 'Unknown install scope: %s\n' "$scope" >&2
                exit 2
                ;;
        esac
    done

    if $install_core; then
        "$repo_dir/scripts/install-mise"
        if command -v mise >/dev/null 2>&1; then
            mise_bin=$(command -v mise)
        else
            mise_bin=$HOME/.local/bin/mise
        fi
        MISE_CONFIG_FILE="$repo_dir/home/.config/mise/config.toml" \
            "$mise_bin" install
    fi
    if $install_personal; then
        "$repo_dir/scripts/install-latest-git"
    fi
}

run_doctor() {
    new_workspace
    collect_sources "$@"
    failures=0
    while IFS='	' read -r relative source_path forced_method; do
        [ -n "$relative" ] || continue
        method=$(method_for "$relative" "$forced_method")
        target=$target_home/$relative
        desired=$source_path
        if [ "$method" = template ]; then
            desired=$workspace/rendered-doctor
            render_template "$source_path" "$desired"
        fi
        if [ "$method" = link ]; then
            if [ -L "$target" ] && [ "$(readlink "$target")" = "$source_path" ]; then
                printf 'OK       %s\n' "$target"
            else
                printf 'DRIFT    %s\n' "$target"
                failures=$((failures + 1))
            fi
        elif [ -f "$target" ] && [ ! -L "$target" ] && cmp -s "$target" "$desired"; then
            printf 'OK       %s\n' "$target"
        else
            printf 'DRIFT    %s\n' "$target"
            failures=$((failures + 1))
        fi
    done <"$sources"
    printf '\n%d drifted or missing path(s).\n' "$failures"
    [ "$failures" -eq 0 ]
}

run_explain() {
    [ "$#" -eq 1 ] || {
        usage >&2
        exit 2
    }
    requested=$1
    case "$requested" in
        "$target_home"/*) relative=${requested#"$target_home"/} ;;
        /*)
            printf 'Path is outside target home: %s\n' "$requested" >&2
            exit 2
            ;;
        *) relative=${requested#./} ;;
    esac
    new_workspace
    collect_sources core personal private
    record=$(awk -F '	' -v wanted="$relative" '$1 == wanted { print; exit }' "$sources")
    [ -n "$record" ] || {
        printf 'Not managed: %s\n' "$requested" >&2
        exit 1
    }
    source_path=$(printf '%s\n' "$record" | awk -F '	' '{print $2}')
    forced_method=$(printf '%s\n' "$record" | awk -F '	' '{print $3}')
    method=$(method_for "$relative" "$forced_method")
    printf 'Target:   %s/%s\nSource:   %s\nMethod:   %s\nPlatform: %s\n' \
        "$target_home" "$relative" "$source_path" "$method" "$platform"
}

command=${1:-help}
[ "$#" -eq 0 ] || shift
case "$command" in
    plan) run_plan_or_apply plan "$@" ;;
    apply) run_plan_or_apply apply "$@" ;;
    install) run_install "$@" ;;
    doctor) run_doctor "$@" ;;
    explain) run_explain "$@" ;;
    help | -h | --help) usage ;;
    *)
        printf 'Unknown command: %s\n\n' "$command" >&2
        usage >&2
        exit 2
        ;;
esac
