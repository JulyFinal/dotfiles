#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
target_home=${DOTFILES_HOME:-$HOME}
manifest_file=${DOTFILES_MANIFEST_FILE:-"$repo_dir/manifests/files.yaml"}
secrets_file=${DOTFILES_SECRETS_FILE:-"$repo_dir/secrets.toml"}
minijinja_bin=
yes=false
workspace=
manifest_records=
sources=
actions=
action_count=0
field_sep=$(printf '\t')

cleanup() {
    [ -z "$workspace" ] || rm -rf "$workspace"
}
trap cleanup EXIT HUP INT TERM

usage() {
    cat <<'EOF'
Usage:
  ./dotfiles plan [core] [personal]
  ./dotfiles apply [core] [personal] [--yes]
  ./dotfiles install [core] [yazi]
  ./dotfiles doctor [core] [personal]
  ./dotfiles explain PATH

`apply` never accesses the network. `install` is the explicit networked action.
Set DOTFILES_SECRETS_FILE to use a manually moved secrets.toml.
EOF
}

detect_platform() {
    case "$(uname -s)" in
        Darwin) printf '%s\n' macos ;;
        Linux)
            if [ -e /etc/arch-release ]; then
                printf '%s\n' arch
            else
                printf '%s\n' linux
            fi
            ;;
        *) printf '%s\n' unsupported ;;
    esac
}

platform=${DOTFILES_PLATFORM:-$(detect_platform)}
case "$platform" in
    arch | linux | macos) ;;
    *)
        printf 'Unsupported platform: %s\n' "$platform" >&2
        exit 1
        ;;
esac

new_workspace() {
    workspace=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-plan.XXXXXX")
    manifest_records=$workspace/manifest-records
    sources=$workspace/sources
    actions=$workspace/actions
    : >"$manifest_records"
    : >"$sources"
    : >"$actions"
    mkdir -p "$workspace/rendered"
}

validate_relative_path() {
    case "$1" in
        '' | . | .. | /* | ../* | */../* | */..) return 1 ;;
        *) return 0 ;;
    esac
}

parse_manifest() {
    [ -f "$manifest_file" ] || {
        printf 'Missing deployment menu: %s\n' "$manifest_file" >&2
        exit 1
    }

    awk '
        function trim(value) {
            sub(/^[[:space:]]+/, "", value)
            sub(/[[:space:]]+$/, "", value)
            return value
        }
        function scalar(value) {
            value = trim(value)
            if (value ~ /^".*"$/) {
                value = substr(value, 2, length(value) - 2)
            }
            return value
        }
        function list(value) {
            value = trim(value)
            if (value == "") return ""
            if (value ~ /^\[.*\]$/) {
                value = substr(value, 2, length(value) - 2)
                gsub(/[[:space:]" ]/, "", value)
                return value
            }
            return scalar(value)
        }
        function emit_group() {
            if (group_id != "") {
                printf "group\t%s\t%s\n", group_id, group_label
            }
            group_id = ""
            group_label = ""
        }
        function emit_entry() {
            if (entry_id != "") {
                if (entry_platforms == "") entry_platforms = "all"
                printf "entry\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", \
                    entry_id, entry_group, entry_source, entry_target, \
                    entry_method, entry_mode, entry_platforms, entry_requires
            }
            entry_id = ""
            entry_group = ""
            entry_source = ""
            entry_target = ""
            entry_method = ""
            entry_mode = ""
            entry_platforms = ""
            entry_requires = ""
        }
        function field(line,    separator, key, value) {
            sub(/^[[:space:]-]+/, "", line)
            separator = index(line, ":")
            if (separator == 0) return
            key = substr(line, 1, separator - 1)
            value = substr(line, separator + 1)
            if (section == "groups") {
                if (key == "id") group_id = scalar(value)
                else if (key == "label") group_label = scalar(value)
            } else if (section == "entries") {
                if (key == "id") entry_id = scalar(value)
                else if (key == "group") entry_group = scalar(value)
                else if (key == "source") entry_source = scalar(value)
                else if (key == "target") entry_target = scalar(value)
                else if (key == "method") entry_method = scalar(value)
                else if (key == "mode") entry_mode = scalar(value)
                else if (key == "platforms") entry_platforms = list(value)
                else if (key == "requires") entry_requires = list(value)
            }
        }
        /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
        /^[[:space:]]*groups:[[:space:]]*$/ {
            emit_entry()
            section = "groups"
            next
        }
        /^[[:space:]]*entries:[[:space:]]*$/ {
            emit_group()
            section = "entries"
            next
        }
        section == "groups" && /^[[:space:]]*-[[:space:]]+id:/ {
            emit_group()
            field($0)
            next
        }
        section == "groups" && /^[[:space:]]+[a-z_]+:/ {
            field($0)
            next
        }
        section == "entries" && /^[[:space:]]*-[[:space:]]+id:/ {
            emit_entry()
            field($0)
            next
        }
        section == "entries" && /^[[:space:]]+[a-z_]+:/ {
            field($0)
            next
        }
        END {
            emit_group()
            emit_entry()
        }
    ' "$manifest_file" >"$manifest_records"

    awk -F '\t' '
        $1 == "group" {
            if ($2 == "" || $3 == "") bad = 1
            groups[$2] = 1
        }
        $1 == "entry" && ($2 == "" || $3 == "" || $4 == "" || $5 == "" || $6 == "" || $7 == "") { bad = 1 }
        $1 == "entry" {
            if (target[$5]++) bad = 1
            if (entry[$2]++) bad = 1
            if (!groups[$3]) bad = 1
            if ($6 !~ /^(link|copy|template)$/) bad = 1
            if ($7 !~ /^[0-7][0-7][0-7][0-7]?$/) bad = 1
        }
        END {
            if (bad) {
                print "Invalid deployment menu: every group and entry needs its required fields." > "/dev/stderr"
                exit 1
            }
        }
    ' "$manifest_records"
}

manifest_groups() {
    awk -F '\t' '$1 == "group" { print $2 }' "$manifest_records"
}

platform_matches() {
    platforms=$1
    if [ -z "$platforms" ] || [ "$platforms" = all ]; then
        return 0
    fi
    old_ifs=$IFS
    IFS=','
    for candidate in $platforms; do
        if [ "$candidate" = "$platform" ]; then
            IFS=$old_ifs
            return 0
        fi
    done
    IFS=$old_ifs
    return 1
}

resolve_minijinja() {
    candidate=$(command -v minijinja-cli 2>/dev/null || true)
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
        minijinja_bin=$candidate
        return 0
    fi

    if command -v mise >/dev/null 2>&1; then
        candidate=$(MISE_CONFIG_FILE="$repo_dir/config/mise/config.toml" \
            mise which minijinja-cli 2>/dev/null || true)
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
            minijinja_bin=$candidate
            return 0
        fi
    fi

    return 1
}

require_commands() {
    requires=$1
    [ -n "$requires" ] || return 0
    old_ifs=$IFS
    IFS=','
    for required in $requires; do
        if [ "$required" = minijinja-cli ]; then
            if [ -z "$minijinja_bin" ] && ! resolve_minijinja; then
                printf 'Required command is missing: %s\n' "$required" >&2
                IFS=$old_ifs
                return 1
            fi
        elif ! command -v "$required" >/dev/null 2>&1; then
            printf 'Required command is missing: %s\n' "$required" >&2
            IFS=$old_ifs
            return 1
        fi
    done
    IFS=$old_ifs
}

collect_sources() {
    parse_manifest
    [ "$#" -gt 0 ] || set -- core

    for requested_group in "$@"; do
        if ! awk -F '\t' -v wanted="$requested_group" \
            '$1 == "group" && $2 == wanted { found = 1 } END { exit !found }' \
            "$manifest_records"; then
            printf 'Unknown configuration group: %s\n' "$requested_group" >&2
            exit 2
        fi

        awk -F '\t' -v wanted="$requested_group" \
            '$1 == "entry" && $3 == wanted { print }' "$manifest_records" \
            | while IFS="$field_sep" read -r record_type id group source target method mode platforms requires; do
                platform_matches "$platforms" || continue
                validate_relative_path "$source" || {
                    printf 'Unsafe deployment source: %s\n' "$source" >&2
                    exit 1
                }
                validate_relative_path "$target" || {
                    printf 'Unsafe deployment target: %s\n' "$target" >&2
                    exit 1
                }
                source_path=$repo_dir/$source
                [ -f "$source_path" ] || [ -L "$source_path" ] || {
                    printf 'Missing deployment source: %s\n' "$source_path" >&2
                    exit 1
                }
                require_commands "$requires" || exit 1
                printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
                    "$target" "$source_path" "$method" "$mode" "$id" "$group" \
                    >>"$sources"
            done
    done
}

render_template() {
    template=$1
    output=$2
    if [ -z "$minijinja_bin" ] && ! resolve_minijinja; then
        printf 'Template %s needs MiniJinja; run ./dotfiles install core first.\n' \
            "$template" >&2
        return 1
    fi

    if command -v docker >/dev/null 2>&1; then
        docker_available=true
    else
        docker_available=false
    fi

    if [ -f "$secrets_file" ]; then
        if ! "$minijinja_bin" --config-file "$repo_dir/minijinja.toml" \
            --strict --no-include --autoescape none \
            -D "home=$target_home" \
            -D "docker_available:=$docker_available" \
            "$template" "$secrets_file" >"$output"; then
            printf 'Failed to render template: %s\n' "$template" >&2
            return 1
        fi
    elif ! "$minijinja_bin" --config-file "$repo_dir/minijinja.toml" \
        --strict --no-include --autoescape none \
        -D "home=$target_home" \
        -D "docker_available:=$docker_available" \
        "$template" >"$output"; then
        printf 'Failed to render template: %s\n' "$template" >&2
        return 1
    fi
}

show_diff() {
    current=$1
    desired=$2
    if [ -f "$current" ] && [ ! -L "$current" ] && [ -f "$desired" ]; then
        diff -u "$current" "$desired" || true
    fi
}

build_plan() {
    index=0
    action_count=0
    printf 'Platform: %s\nTarget:   %s\n\n' "$platform" "$target_home"

    while IFS="$field_sep" read -r relative source_path method mode id group; do
        [ -n "$relative" ] || continue
        target=$target_home/$relative
        desired=$source_path

        case "$method" in
            link | copy) ;;
            template)
                index=$((index + 1))
                desired=$workspace/rendered/$index
                render_template "$source_path" "$desired"
                ;;
            *)
                printf 'Invalid deployment method for %s: %s\n' "$id" "$method" >&2
                exit 1
                ;;
        esac

        unchanged=false
        if [ "$method" = link ]; then
            if [ -L "$target" ] && [ "$(readlink "$target")" = "$source_path" ]; then
                unchanged=true
            fi
        elif [ -f "$target" ] && [ ! -L "$target" ] \
            && cmp -s "$target" "$desired" && mode_matches "$mode" "$target"; then
            unchanged=true
        fi

        if $unchanged; then
            printf 'KEEP     %s  [%s]\n' "$target" "$id"
            continue
        fi

        if [ -e "$target" ] || [ -L "$target" ]; then
            printf 'REPLACE  %s  (%s)  [%s]\n' "$target" "$method" "$id"
            show_diff "$target" "$desired"
        else
            printf 'CREATE   %s  (%s)  [%s]\n' "$target" "$method" "$id"
        fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$method" "$relative" "$desired" "$target" "$mode" "$id" >>"$actions"
        action_count=$((action_count + 1))
    done <"$sources"

    printf '\n%d change(s) planned.\n' "$action_count"
}

clean_parent_symlinks() {
    target_path=$1
    dir=${target_path%/*}
    curr=""
    old_ifs=$IFS
    IFS='/'
    for segment in $dir; do
        [ -n "$segment" ] || continue
        curr="$curr/$segment"
        if [ -L "$curr" ] && [ ! -d "$curr" ]; then
            rm -f "$curr"
        fi
    done
    IFS=$old_ifs
    mkdir -p "$dir"
}

apply_actions() {
    while IFS="$field_sep" read -r method relative desired target mode id; do
        [ -n "$target" ] || continue
        clean_parent_symlinks "$target"
        if [ -d "$target" ] && [ ! -L "$target" ]; then
            rm -rf "$target"
        else
            rm -f "$target"
        fi
        if [ "$method" = link ]; then
            ln -s "$desired" "$target"
        else
            cp "$desired" "$target"
            chmod "$mode" "$target"
        fi
        printf 'APPLIED  %s  [%s]\n' "$target" "$id"
    done <"$actions"
}

configure_secret_hook() {
    if [ "$target_home" = "$HOME" ] && git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1; then
        git -C "$repo_dir" config core.hooksPath tests
        printf 'ENABLED  repository secret-scanning hook\n'
    fi
}

file_mode() {
    stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1"
}

mode_matches() {
    expected=${1#0}
    actual=$(file_mode "$2")
    [ "$actual" = "$expected" ] || [ "$actual" = "$1" ]
}

run_plan_or_apply() {
    operation=$1
    shift
    scopes=
    for argument in "$@"; do
        if [ "$argument" = --yes ]; then
            yes=true
        else
            scopes="$scopes $argument"
        fi
    done
    # Scope values come from the manifest's group identifiers.
    # shellcheck disable=SC2086
    set -- $scopes
    [ "$#" -gt 0 ] || set -- core

    new_workspace
    collect_sources "$@"
    build_plan
    [ "$operation" = apply ] || return 0
    if [ "$action_count" -eq 0 ]; then
        configure_secret_hook
        return 0
    fi

    if ! $yes; then
        printf '\nApply these changes? [y/N] '
        IFS= read -r answer
        case "$answer" in
            y | Y | yes | YES) ;;
            *)
                printf '%s\n' 'Cancelled.'
                return 1
                ;;
        esac
    fi
    apply_actions
    configure_secret_hook
}

run_install() {
    [ "$#" -gt 0 ] || set -- core
    install_core=false
    install_yazi=false
    for scope in "$@"; do
        case "$scope" in
            core) install_core=true ;;
            yazi) install_yazi=true ;;
            *)
                printf 'Unknown install scope: %s\n' "$scope" >&2
                exit 2
                ;;
        esac
    done

    "$repo_dir/scripts/install-mise"
    if command -v mise >/dev/null 2>&1; then
        mise_bin=$(command -v mise)
    else
        mise_bin=$HOME/.local/bin/mise
    fi
    if $install_core; then
        MISE_CONFIG_FILE="$repo_dir/config/mise/config.toml" \
            "$mise_bin" install
    fi

    if $install_yazi; then
        yazi_config_home=$target_home/.config/yazi
        [ -f "$yazi_config_home/package.toml" ] || {
            printf '%s\n' \
                'Yazi package.toml is missing; apply personal before installing Yazi.' \
                >&2
            exit 1
        }
        MISE_CONFIG_FILE="$repo_dir/config/mise/config.toml" \
            "$mise_bin" install yazi
        YAZI_CONFIG_HOME="$yazi_config_home" \
            MISE_CONFIG_FILE="$repo_dir/config/mise/config.toml" \
            "$mise_bin" exec -- ya pkg install
    fi
}

run_doctor() {
    new_workspace
    collect_sources "$@"
    failures=0
    while IFS="$field_sep" read -r relative source_path method mode id group; do
        [ -n "$relative" ] || continue
        target=$target_home/$relative
        desired=$source_path
        if [ "$method" = template ]; then
            desired=$workspace/rendered-doctor/$id
            mkdir -p "$(dirname "$desired")"
            render_template "$source_path" "$desired"
        fi
        if [ "$method" = link ]; then
            if [ -L "$target" ] && [ "$(readlink "$target")" = "$source_path" ]; then
                printf 'OK       %s\n' "$target"
            else
                printf 'DRIFT    %s\n' "$target"
                failures=$((failures + 1))
            fi
        elif [ -f "$target" ] && [ ! -L "$target" ] \
            && cmp -s "$target" "$desired" && mode_matches "$mode" "$target"; then
            printf 'OK       %s\n' "$target"
        else
            printf 'DRIFT    %s\n' "$target"
            failures=$((failures + 1))
        fi
    done <"$sources"
    printf '\n%d drifted or missing path(s).\n' "$failures"
    [ "$failures" -eq 0 ]
}

run_explain() {
    [ "$#" -eq 1 ] || {
        usage >&2
        exit 2
    }
    requested=$1
    case "$requested" in
        "$target_home"/*) relative=${requested#"$target_home"/} ;;
        /*)
            printf 'Path is outside target home: %s\n' "$requested" >&2
            exit 2
            ;;
        *) relative=${requested#./} ;;
    esac
    new_workspace
    parse_manifest >/dev/null
    groups=$(manifest_groups | tr '\n' ' ')
    # shellcheck disable=SC2086
    collect_sources $groups
    record=$(awk -F '\t' -v wanted="$relative" '$1 == wanted { print; exit }' "$sources")
    [ -n "$record" ] || {
        printf 'Not managed: %s\n' "$requested" >&2
        exit 1
    }
    old_ifs=$IFS
    IFS="$field_sep" read -r record_relative record_source record_method record_mode record_id record_group <<EOF
$record
EOF
    IFS=$old_ifs
    printf 'Target:   %s/%s\nSource:   %s\nMethod:   %s\nMode:     %s\nEntry:    %s\nPlatform: %s\n' \
        "$target_home" "$record_relative" "$record_source" "$record_method" \
        "$record_mode" "$record_id" "$platform"
}

command=${1:-help}
[ "$#" -eq 0 ] || shift
case "$command" in
    plan) run_plan_or_apply plan "$@" ;;
    apply) run_plan_or_apply apply "$@" ;;
    install) run_install "$@" ;;
    doctor) run_doctor "$@" ;;
    explain) run_explain "$@" ;;
    help | -h | --help) usage ;;
    *)
        printf 'Unknown command: %s\n\n' "$command" >&2
        usage >&2
        exit 2
        ;;
esac
