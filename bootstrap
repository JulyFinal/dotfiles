#!/usr/bin/env bash
set -euo pipefail

requested_profile=auto
dry_run=false
platform_override=

usage() {
    printf '%s\n' \
        'Usage: ./bootstrap [--profile auto|portable|laptop-intel|laptop-amd|desktop] [--dry-run]' \
        '       ./bootstrap --dry-run --platform arch|macos|linux'
}

while (($#)); do
    case "$1" in
        --profile)
            requested_profile=${2:?missing profile}
            shift 2
            ;;
        --platform)
            platform_override=${2:?missing platform}
            shift 2
            ;;
        --dry-run)
            dry_run=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            printf 'Unknown option: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

case "$requested_profile" in
    auto|portable|laptop|laptop-intel|laptop-amd|desktop) ;;
    *) printf 'Unsupported profile: %s\n' "$requested_profile" >&2; exit 2 ;;
esac

detect_platform() {
    case "$(uname -s)" in
        Darwin) printf '%s\n' macos ;;
        Linux)
            if [[ -e /etc/arch-release ]]; then
                printf '%s\n' arch
            else
                printf '%s\n' linux
            fi
            ;;
        *)
            printf 'Unsupported operating system: %s\n' "$(uname -s)" >&2
            return 1
            ;;
    esac
}

actual_platform=$(detect_platform)
platform=$actual_platform
if [[ -n "$platform_override" ]]; then
    case "$platform_override" in
        arch|macos|linux) ;;
        *) printf 'Unsupported platform override: %s\n' "$platform_override" >&2; exit 2 ;;
    esac
    if ! $dry_run; then
        printf '%s\n' '--platform is only allowed together with --dry-run.' >&2
        exit 2
    fi
    platform=$platform_override
fi

if [[ "$requested_profile" == auto ]]; then
    if [[ "$platform" == arch ]]; then
        profile=laptop-intel
    else
        profile=portable
    fi
else
    profile=$requested_profile
fi

if [[ "$platform" != arch && "$profile" != portable ]]; then
    printf 'Profile %s is Arch-specific; use --profile portable on %s.\n' \
        "$profile" "$platform" >&2
    exit 2
fi

case "$profile" in
    laptop|laptop-intel) display_profile=laptop; hardware_profile=intel ;;
    laptop-amd) display_profile=laptop; hardware_profile=amd ;;
    desktop) display_profile=desktop; hardware_profile=none ;;
    portable) display_profile=portable; hardware_profile=none ;;
esac

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

read_list() {
    sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$1"
}

pacman_packages=()
aur_packages=()
brew_packages=()
brew_casks=()
nix_packages=()
paru_build_dir=

if [[ "$platform" == arch ]]; then
    while IFS= read -r package; do
        pacman_packages+=("$package")
    done < <(read_list "$repo_dir/packages/pacman-common.txt")
    if [[ "$display_profile" == laptop ]]; then
        while IFS= read -r package; do
            pacman_packages+=("$package")
        done < <(read_list "$repo_dir/packages/pacman-laptop.txt")
    fi
    if [[ "$hardware_profile" != none ]]; then
        while IFS= read -r package; do
            pacman_packages+=("$package")
        done < <(read_list "$repo_dir/packages/pacman-$hardware_profile.txt")
    fi
    while IFS= read -r package; do
        aur_packages+=("$package")
    done < <(read_list "$repo_dir/packages/aur.txt")
elif [[ "$platform" == macos ]]; then
    while IFS= read -r package; do
        brew_packages+=("$package")
    done < <(read_list "$repo_dir/packages/brew-common.txt")
    while IFS= read -r package; do
        brew_casks+=("$package")
    done < <(read_list "$repo_dir/packages/brew-cask.txt")
else
    while IFS= read -r package; do
        nix_packages+=("$package")
    done < <(read_list "$repo_dir/packages/nix-common.txt")
fi

print_packages() {
    local heading=$1
    shift
    printf '\n%s:\n' "$heading"
    if (($#)); then
        printf '  %s\n' "$@"
    else
        printf '%s\n' '  (none)'
    fi
}

if $dry_run; then
    printf 'Platform: %s\nProfile: %s (display=%s, hardware=%s)\n' \
        "$platform" "$profile" "$display_profile" "$hardware_profile"
    case "$platform" in
        arch)
            print_packages 'Pacman packages' "${pacman_packages[@]}"
            print_packages 'AUR packages' "${aur_packages[@]}"
            ;;
        macos)
            print_packages 'Homebrew formulae' "${brew_packages[@]}"
            print_packages 'Homebrew casks' "${brew_casks[@]}"
            ;;
        linux)
            print_packages 'Nix profile packages' "${nix_packages[@]}"
            ;;
    esac
    if [[ -z "$platform_override" ]] && command -v chezmoi >/dev/null 2>&1; then
        chezmoi --source "$repo_dir" --destination "$HOME" diff || true
    fi
    exit 0
fi

# Keep the repository's secret gate active on every restored machine.
git -C "$repo_dir" config core.hooksPath tests

install_arch_packages() {
    sudo pacman -Syu --needed --noconfirm "${pacman_packages[@]}"

    if ! command -v paru >/dev/null 2>&1; then
        paru_build_dir=$(mktemp -d /tmp/paru-bootstrap.XXXXXX)
        trap 'rm -rf -- "$paru_build_dir"' EXIT
        git clone --depth 1 https://aur.archlinux.org/paru.git "$paru_build_dir/paru"
        (cd "$paru_build_dir/paru" && makepkg -si --needed --noconfirm)
    fi

    paru -S --needed --noconfirm "${aur_packages[@]}"
}

load_homebrew() {
    if command -v brew >/dev/null 2>&1; then
        return
    fi
    if [[ -x /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -x /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)"
    else
        printf '%s\n' \
            'Homebrew is required on macOS.' \
            'Install it from https://brew.sh, then run ./bootstrap again.' >&2
        return 1
    fi
}

install_macos_packages() {
    load_homebrew
    brew update
    brew install "${brew_packages[@]}"
    brew install --cask "${brew_casks[@]}"
    brew upgrade "${brew_packages[@]}"
    brew upgrade --cask "${brew_casks[@]}"
}

load_nix() {
    if command -v nix >/dev/null 2>&1; then
        return
    fi
    local nix_profile_script=$HOME/.nix-profile/etc/profile.d/nix.sh
    if [[ -r "$nix_profile_script" ]]; then
        # shellcheck disable=SC1090
        . "$nix_profile_script"
    fi
    if ! command -v nix >/dev/null 2>&1; then
        printf '%s\n' \
            'Nix is required on non-Arch Linux.' \
            'Install it from https://nixos.org/download, then run ./bootstrap again.' >&2
        return 1
    fi
}

nix_profile_has() {
    local package=$1
    nix --extra-experimental-features 'nix-command flakes' profile list --json |
        grep -Eq "\"${package}\"[[:space:]]*:"
}

install_linux_packages() {
    load_nix
    local package
    for package in "${nix_packages[@]}"; do
        if nix_profile_has "$package"; then
            nix --extra-experimental-features 'nix-command flakes' \
                profile upgrade "$package"
        else
            nix --extra-experimental-features 'nix-command flakes' \
                profile install "nixpkgs#$package"
        fi
    done
    export PATH="$HOME/.nix-profile/bin:$PATH"
}

case "$platform" in
    arch) install_arch_packages ;;
    macos) install_macos_packages ;;
    linux) install_linux_packages ;;
esac

config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi
mkdir -p "$config_dir"
DOTFILES_SOURCE_DIR="$repo_dir" \
DOTFILES_PROFILE="$profile" \
DOTFILES_PLATFORM="$platform" \
    chezmoi --source "$repo_dir" execute-template < "$repo_dir/.chezmoi.toml.tmpl" \
    > "$config_dir/chezmoi.toml"
chezmoi --source "$repo_dir" --destination "$HOME" apply --force

if [[ "$platform" == arch ]]; then
    sudo install -Dm0644 \
        "$repo_dir/rootfs/etc/xdg/reflector/reflector.conf" \
        /etc/xdg/reflector/reflector.conf

    while IFS= read -r unit; do
        [[ -n "$unit" ]] && sudo systemctl enable "$unit"
    done < "$repo_dir/services/system-common.txt"
    if [[ "$display_profile" == laptop ]]; then
        while IFS= read -r unit; do
            [[ -n "$unit" ]] && sudo systemctl enable "$unit"
        done < "$repo_dir/services/system-laptop.txt"
    fi
fi

if [[ "$platform" == arch || "$platform" == linux ]]; then
    systemctl --user daemon-reload
    if [[ "$platform" == arch ]]; then
        user_service_file=$repo_dir/services/user-common.txt
    else
        user_service_file=$repo_dir/services/user-portable.txt
    fi
    while IFS= read -r unit; do
        [[ -n "$unit" ]] && systemctl --user enable --now "$unit"
    done < "$user_service_file"
else
    "$HOME/.local/bin/proxyctl" start
fi

mise install
"$repo_dir/scripts/sync-pi-skills"

# Make the first interactive Neovim launch deterministic. Restore the locked
# plugin revisions and pre-install the parsers declared by the configuration.
mise exec -- nvim --headless \
    '+Lazy! restore' \
    '+Lazy load nvim-treesitter' \
    '+TSUpdateSync lua python toml bash json' \
    '+qa'

"$repo_dir/doctor"
